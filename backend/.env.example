# MySQL local (ví dụ XAMPP). Cấu hình mặc định dự án: user root, mật khẩu 123456, port 3306.
# Nếu root không mật khẩu: mysql://root:@localhost:3306/tmdt
DATABASE_URL="mysql://root:123456@localhost:3306/tmdt"

# Đổi thành một chuỗi ngẫu nhiên, dài, giữ bí mật
JWT_SECRET="change_this_to_a_random_secret"
JWT_EXPIRES_IN="7d"

# UC-24 (Nhóm D – Quản trị): secret RIÊNG cho token /admin, tách biệt khỏi JWT_SECRET của Customer.
ADMIN_JWT_SECRET="change_this_to_another_random_secret"
ADMIN_JWT_EXPIRES_IN="8h"

PORT=4000
CLIENT_URL="http://localhost:5173"

# Tài khoản quản trị mặc định do `npm run db:seed` tạo (chỉ khi chưa tồn tại).
# SEED_ADMIN_USERNAME="admin"
# SEED_ADMIN_PASSWORD="Admin@123456"

# Xác thực tài khoản (UC-05) dùng MÃ OTP 6 số gửi về email. Cần cấu hình SMTP bên dưới để gửi
# thật; nếu bỏ trống SMTP, mã OTP chỉ được log ra console (dev). API KHÔNG bao giờ trả mã về client.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="you@gmail.com"
# SMTP_PASS="app_password"
# MAIL_FROM="StayTour <no-reply@staytour.example>"

# Đăng nhập/đăng ký bằng Google (UC-05 1a / UC-06 1b).
# Chỉ cần Client ID (Web) từ Google Cloud Console; KHÔNG cần client secret.
# GOOGLE_CLIENT_ID="xxxxx.apps.googleusercontent.com"

# Giữ chỗ (UC-09/10). Hạn giữ chỗ tạm (phút).
# HOLD_MINUTES=15
# Tỷ lệ đặt cọc và chính sách hủy/hoàn tiền (UC-09/10/11/14/18) nay được cấu hình qua
# khu vực quản trị (UC-23 - Cấu hình hệ thống), KHÔNG còn đọc từ biến môi trường.

# Thanh toán VNPAY sandbox (UC-11). Bỏ trống -> chỉ dùng COD.
# Đăng ký merchant sandbox tại https://sandbox.vnpayment.vn để lấy TmnCode + HashSecret.
# BACKEND_URL="http://localhost:4000"
# VNP_TMN_CODE="xxxxxxxx"
# VNP_HASH_SECRET="xxxxxxxxxxxxxxxx"
# VNP_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"

# Luồng 1 "Trả sau 0đ" — Stripe pre-authorization (giữ thẻ bảo lãnh chống bùng, KHÔNG trừ tiền).
# Lấy test keys tại https://dashboard.stripe.com/test/apikeys. Bỏ trống -> nút "Trả sau" không yêu
# cầu thẻ (đơn vẫn ở trạng thái "đã xác nhận · chưa thanh toán", thu khi đi/nhận phòng).
# STRIPE_SECRET_KEY="sk_test_xxx"
# STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
# STRIPE_WEBHOOK_SECRET="whsec_xxx"
# STRIPE_HOLD_AMOUNT=  # VND, ép số tiền tạm giữ; bỏ trống -> mặc định dùng mức cọc của đơn
