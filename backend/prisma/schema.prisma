generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ProductType {
  HOMESTAY
  TOUR
}

enum ProductStatus {
  VISIBLE
  HIDDEN
}

// ===== Tour (bảng riêng, tách khỏi Product) — thiết kế theo dữ liệu đặc tả tour =====
enum TourStatus {
  DRAFT // nháp, chưa công bố
  VISIBLE // BR-79: đang hiển thị
  HIDDEN // đã ẩn
}

enum DepartureStatus {
  OPEN // còn mở bán
  CLOSED // admin đóng (UC-17 4a)
  FULL // hết chỗ
  CANCELLED // hủy chuyến
}

enum PaxType {
  ADULT
  CHILD
  INFANT
}

enum InclusionType {
  INCLUDED // bao gồm
  EXCLUDED // không bao gồm
}

enum TourNoteType {
  TERM // điều khoản / cần biết trước khi đặt
  FAQ // câu hỏi thường gặp
  REDEMPTION // hướng dẫn sử dụng vé/redemption
}

// ===== Property (chỗ nghỉ — bảng riêng, mô hình 3 tầng Property→RoomType→RoomInventory) =====
enum PropertyType {
  HOMESTAY
  HOTEL
  VILLA
  APARTMENT
  RESORT
}

enum PropertyStatus {
  DRAFT
  VISIBLE // BR-73
  HIDDEN
}

enum AmenityScope {
  GENERAL // tiện nghi chung của chỗ nghỉ
  ROOM // tiện nghi theo phòng
}

enum PropertyPolicyType {
  HOUSE_RULE // nội quy (vd xuất trình giấy tờ khi nhận phòng)
  NOTE // ghi chú
  FAQ // câu hỏi thường gặp
}

// Nhóm D – Quản trị (khu vực /admin, hoàn toàn tách biệt khỏi User của website chính).
enum AdminRole {
  SUPER_ADMIN // toàn quyền, bao gồm UC-19 cấp quyền cho admin khác
  MANAGER // quản lý sản phẩm/đơn/khuyến mại/đánh giá, không cấp quyền tài khoản
}

model Admin {
  id                  Int        @id @default(autoincrement())
  username            String     @unique
  email               String?    @unique // để gửi OTP 2FA + thông tin tài khoản + nhắc hạn mật khẩu
  password            String // BR-69: băm bcrypt
  name                String?
  role                AdminRole  @default(MANAGER) // BR-68: RBAC phía máy chủ
  active              Boolean    @default(true) // BR-68: tài khoản bị khóa thì không đăng nhập được
  failedLoginAttempts Int        @default(0) // BR-70
  lockedUntil         DateTime? // BR-70

  // Bảo mật nâng cao
  activated           Boolean    @default(true) // tài khoản mới phải kích hoạt lần đầu qua link token
  mustChangePassword  Boolean    @default(false) // buộc đổi mật khẩu (lần đầu / hết hạn)
  passwordChangedAt   DateTime   @default(now()) // mốc tính hạn mật khẩu (đổi mỗi 30 ngày)
  expiryReminderStage Int        @default(0) // mốc nhắc hạn đã gửi: 0 chưa, 1=7 ngày, 2=3 ngày, 3=1 ngày
  activationTokenHash String? // băm token kích hoạt lần đầu (one-time)
  activationExpiresAt DateTime?
  otpHash             String? // băm OTP 2FA của phiên đăng nhập đang chờ xác thực
  otpExpiresAt        DateTime?
  otpAttempts         Int        @default(0)

  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  loginAttempts AdminLoginAttempt[]
  auditLogs     AdminAuditLog[]
  tours         Tour[]
  properties    Property[]
  travelGuides  TravelGuide[]

  @@index([role])
}

// UC-24 – Ghi vết đăng nhập quản trị (BR-70/78).
model AdminLoginAttempt {
  id        Int      @id @default(autoincrement())
  username  String
  adminId   Int?
  admin     Admin?   @relation(fields: [adminId], references: [id])
  ip        String?
  success   Boolean
  reason    String? // vd: "wrong_password" | "not_admin" | "locked" | "inactive"
  createdAt DateTime @default(now())

  @@index([username])
  @@index([adminId])
}

// UC-23 – Cấu hình hệ thống (BR-113/114): tham số nền cho UC-09/10/11 (tỷ lệ cọc) và
// UC-14/18/04 (mốc thời gian + tỷ lệ hoàn tiền của chính sách hủy) + thông tin người bán.
// Bảng chỉ có đúng 1 dòng (id luôn = 1) — không phải key/value vì tập tham số đã cố định theo đặc tả.
model SystemConfig {
  id                 Int      @id @default(1)
  depositRatePercent Int      @default(30) // BR-113: % cọc, 1-100
  cancelFreeHours    Int      @default(24) // miễn phí hủy trong X giờ đầu sau khi đặt
  cancelTier1Days    Int      @default(7) // hủy trước >= X ngày so với ngày nhận/khởi hành -> cancelTier1Ratio
  cancelTier1Ratio   Int      @default(100)
  cancelTier2Days    Int      @default(3) // hủy trước >= X ngày (nhưng < tier1) -> cancelTier2Ratio; dưới X ngày -> 0%
  cancelTier2Ratio   Int      @default(50)
  sellerName         String?  @default("StayTour")
  sellerAddress      String?
  sellerPhone        String?
  sellerEmail        String?
  siteNotice         String?  @db.Text // thiết lập chung: thông báo/ghi chú hiển thị công khai (tùy chọn)
  updatedAt          DateTime @updatedAt
}

// Nhóm D (BR-78, ...) – Nhật ký thao tác quản trị, dùng chung cho UC-16→23.
model AdminAuditLog {
  id         Int      @id @default(autoincrement())
  adminId    Int
  admin      Admin    @relation(fields: [adminId], references: [id])
  action     String // vd: "product.create" | "product.hide" | "availability.block" ...
  entityType String? // vd: "Product" | "HomestayAvailability"
  entityId   Int?
  detail     String?  @db.Text // mô tả/JSON ngắn gọn về thay đổi
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([entityType, entityId])
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  password      String? // null với tài khoản đăng nhập bằng Google (không có mật khẩu)
  name          String?
  phone         String? // UC-07: số điện thoại
  address       String? // UC-07: thông tin liên hệ/địa chỉ
  dateOfBirth   DateTime? // ngày sinh (phục vụ vận hành đặt phòng/tour)
  gender        String? // giới tính: MALE / FEMALE / OTHER
  nationality   String? // quốc tịch
  idNumber      String? // số CCCD/CMND hoặc hộ chiếu (định danh khách khi nhận phòng)
  city          String? // tỉnh/thành cư trú
  avatar        String? // ảnh đại diện từ Google (nếu có)
  googleId      String?  @unique // liên kết tài khoản Google (UC-05 1a / UC-06 1b)
  emailVerified Boolean  @default(false) // BR-15: kích hoạt sau khi xác thực email
  acceptedTerms Boolean  @default(false) // BR-14: đồng ý điều khoản & chính sách
  failedLoginAttempts Int      @default(0) // BR-16: đếm lần đăng nhập sai liên tiếp
  lockedUntil         DateTime? // BR-16/2b: thời điểm hết tạm khóa (tự động, tạm thời)
  disabled            Boolean  @default(false) // UC-19/BR-95: khóa bởi quản trị viên (thủ công, vĩnh viễn tới khi mở lại)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  verificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  favorites           Favorite[]
  bookings            Booking[]
}

// UC-09/10 – Đơn đặt (vòng đời đơn của nhóm C).
enum BookingType {
  HOMESTAY
  TOUR
}

enum BookingStatus {
  PENDING_DEPOSIT // chờ cọc (đang giữ chỗ tạm)
  DEPOSITED // đã cọc
  CONFIRMED // đã xác nhận
  COMPLETED // hoàn tất
  CANCELLED // đã hủy
}

model Booking {
  id      Int           @id @default(autoincrement())
  code    String        @unique // mã đơn ngẫu nhiên khó đoán (BR-29)
  pinHash String? // PIN cho guest checkout (băm)
  type    BookingType
  status  BookingStatus @default(PENDING_DEPOSIT)

  // Đa hình: đơn homestay trỏ propertyId + roomTypeId; đơn tour trỏ tourId + tourDepartureId.
  // (productId là di sản của bảng Product cũ, giữ nullable để tương thích trong quá trình di trú.)
  productId       Int? // (cũ, sẽ bỏ)
  product         Product? @relation(fields: [productId], references: [id])
  propertyId      Int? // homestay/chỗ nghỉ
  property        Property? @relation(fields: [propertyId], references: [id])
  roomTypeId      Int? // loại phòng đã đặt
  roomType        RoomType? @relation(fields: [roomTypeId], references: [id])
  tourId          Int? // tour
  tour            Tour?    @relation(fields: [tourId], references: [id])
  tourDepartureId Int? // chuyến khởi hành cụ thể của đơn tour
  userId          Int? // null nếu đặt với tư cách khách (guest checkout)
  user            User?    @relation(fields: [userId], references: [id])

  // Thông tin liên hệ của người đặt
  guestName  String
  guestEmail String
  guestPhone String
  note       String? @db.Text // ghi chú / yêu cầu đặc biệt của khách

  // Homestay: khoảng ngày; Tour: ngày khởi hành (dùng lại checkIn)
  checkIn  DateTime? @db.Date
  checkOut DateTime? @db.Date
  nights   Int?
  guests   Int       @default(1)
  children Int       @default(0)

  // Tiền
  totalPrice      Int
  depositAmount   Int
  remainingAmount Int

  // UC-11 – Thanh toán & đặt cọc
  paymentMethod String? // VNPAY | COD
  transactionId String? // mã giao dịch của cổng (BR-42)
  depositPaidAt DateTime?

  // UC-12 – Mã giảm giá (BR-44: chỉ một mã/đơn)
  discountCode      String?
  discountAmount    Int     @default(0)
  discountConsumed  Boolean @default(false) // BR-47: chỉ trừ lượt khi đã cọc thành công

  heldUntil DateTime? // BR-25: hạn giữ chỗ tạm
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // UC-13 – Tra cứu đơn (Guest). BR-51: chống dò mã bằng khóa tạm sau nhiều lần sai.
  lookupFailCount   Int       @default(0)
  lookupLockedUntil DateTime?

  // UC-14 – Hủy đơn & hoàn tiền
  cancelledAt DateTime?

  payments       Payment[]
  refundRequests RefundRequest[]

  // UC-15 – Đánh giá sau lưu trú
  review      Review?
  reviewToken ReviewToken?

  @@index([productId])
  @@index([propertyId])
  @@index([tourId])
  @@index([userId])
  @@index([status])
}

// UC-14 – Yêu cầu hoàn tiền, chờ quản trị viên xử lý (UC-18). BR-59: ghi vết.
model RefundRequest {
  id        Int      @id @default(autoincrement())
  bookingId Int
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount    Int
  ratio     Int // % hoàn (0-100) theo chính sách tại thời điểm hủy
  status    String   @default("PENDING") // PENDING | PROCESSED
  createdAt DateTime @default(now())

  @@index([bookingId])
}

// UC-13 – Nhật ký tra cứu đơn của Guest (BR-51: ghi vết chống dò mã).
model LookupAttempt {
  id        Int      @id @default(autoincrement())
  code      String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([code])
}

// UC-12 – Mã giảm giá (BR-48: do quản trị viên tạo/cấu hình qua UC-20).
model DiscountCode {
  id            Int       @id @default(autoincrement())
  code          String    @unique
  type          String // PERCENT | FIXED
  value         Int // % (1-100) nếu PERCENT, hoặc số tiền VND nếu FIXED
  minOrderValue Int       @default(0)
  scope         String    @default("ALL") // ALL | HOMESTAY | TOUR
  productId     Int? // (cũ) Product
  product       Product?  @relation(fields: [productId], references: [id])
  propertyId    Int? // tùy chọn: giới hạn cho 1 chỗ nghỉ cụ thể
  property      Property? @relation(fields: [propertyId], references: [id])
  tourId        Int? // tùy chọn: giới hạn cho 1 tour cụ thể
  tour          Tour?     @relation(fields: [tourId], references: [id])
  audience      String    @default("ALL") // ALL | CUSTOMER (chỉ thành viên đã đăng nhập)
  startAt       DateTime?
  endAt         DateTime?
  maxUses       Int?
  usedCount     Int       @default(0)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())

  @@index([productId])
}

// UC-11 – Nhật ký giao dịch thanh toán (BR-41: ghi vết).
model Payment {
  id            Int      @id @default(autoincrement())
  bookingId     Int
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  method        String // VNPAY | COD
  amount        Int
  status        String // SUCCESS | FAILED | PENDING
  transactionId String?
  createdAt     DateTime @default(now())

  @@index([bookingId])
}

// UC-08 – Danh sách yêu thích (BR-22: gắn với tài khoản).
model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int? // (cũ) Product
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  propertyId Int? // homestay/chỗ nghỉ
  property  Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tourId    Int? // tour
  tour      Tour?    @relation(fields: [tourId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@unique([userId, propertyId])
  @@unique([userId, tourId])
  @@index([userId])
}

// Token đặt lại mật khẩu (UC-06 1a). Băm token, có hạn, dùng một lần.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Nhật ký đăng nhập (BR-16: ghi vết).
model LoginAttempt {
  id        Int      @id @default(autoincrement())
  email     String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email])
}

// Token xác thực email (UC-05). Băm token, có hạn dùng, hỗ trợ gửi lại.
model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// Danh mục nhiều cấp (tự tham chiếu). BR-02: số cấp do quản trị viên cấu hình.
model Category {
  id        Int         @id @default(autoincrement())
  name      String
  slug      String      @unique
  type      ProductType
  kind      String? // với danh mục tour: 'region' | 'theme' | 'duration' (BF-02)
  order     Int         @default(0)
  parentId  Int?
  parent    Category?   @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[]  @relation("CategoryTree")
  products  Product[]
  toursAsRegion Tour[]  @relation("TourRegion")
  toursAsTheme  Tour[]  @relation("TourTheme")
  propertiesAsProvince Property[] @relation("PropertyProvince")
  propertiesAsArea     Property[] @relation("PropertyArea")
  createdAt DateTime    @default(now())

  @@index([parentId])
  @@index([type])
}

// Sản phẩm: homestay hoặc tour.
model Product {
  id          Int           @id @default(autoincrement())
  name        String
  slug        String        @unique
  type        ProductType
  status      ProductStatus @default(VISIBLE)
  description String?       @db.Text
  location    String? // tỉnh/thành hoặc vùng miền
  price       Int // giá cơ bản (đồng): homestay/đêm, tour/khách
  rating      Float         @default(0)
  thumbnail   String?
  isFeatured  Boolean       @default(false)
  amenities   String? // tiện nghi homestay, phân tách bằng dấu phẩy
  durationDays Int? // thời lượng tour (số ngày)
  priceChild  Int? // giá trẻ em cho tour (BR-09)
  cancellationPolicy String? @db.Text // chính sách hủy (text công bố; homestay)
  cancellationPolicyId Int? // UC-14/23: chính sách hủy dạng bảng (null = dùng cấu hình mặc định UC-23)
  cancellationPolicyRef CancellationPolicy? @relation(fields: [cancellationPolicyId], references: [id])
  itinerary   String?       @db.Text // (cũ) lịch trình tour — sẽ bỏ sau khi tách Tour
  included    String?       @db.Text // (cũ) mục bao gồm
  excluded    String?       @db.Text // (cũ) mục không bao gồm
  categoryId  Int?
  category    Category?     @relation(fields: [categoryId], references: [id])
  images         ProductImage[]
  reviews        Review[]
  availabilities HomestayAvailability[]
  favorites      Favorite[]
  bookings       Booking[]
  discountCodes  DiscountCode[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([type])
  @@index([status])
  @@index([categoryId])
  @@index([isFeatured])
}

// Thư viện ảnh của sản phẩm (UC-03).
model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  order     Int     @default(0)

  @@index([productId])
}

// Đánh giá của khách. BR-08/BR-63: chỉ hiển thị đánh giá đã được duyệt.
model Review {
  id          Int         @id @default(autoincrement())
  productType ProductType @default(HOMESTAY) // đa hình: HOMESTAY -> propertyId, TOUR -> tourId
  productId   Int? // (cũ) Product
  product     Product?    @relation(fields: [productId], references: [id], onDelete: Cascade)
  propertyId  Int? // homestay/chỗ nghỉ
  property    Property?   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tourId      Int? // tour
  tour        Tour?       @relation(fields: [tourId], references: [id], onDelete: Cascade)
  bookingId   Int?        @unique // UC-15/BR-61: gắn với đơn đã hoàn tất, mỗi đơn chỉ đánh giá 1 lần
  booking     Booking?    @relation(fields: [bookingId], references: [id])
  authorName  String
  rating      Int
  comment     String?     @db.Text
  approved    Boolean     @default(false)
  rejected    Boolean     @default(false) // UC-21/BR-104: từ chối/ẩn — phân biệt với "chờ kiểm duyệt" (cả 2 đều approved=false)
  replyText   String?     @db.Text // Phản hồi của người bán/quản trị gửi tới khách (kèm gửi email)
  repliedAt   DateTime? // thời điểm gửi phản hồi gần nhất
  createdAt   DateTime    @default(now())

  images      ReviewImage[] // UC-15: ảnh đính kèm theo đánh giá

  @@index([productId])
  @@index([propertyId])
  @@index([tourId])
  @@index([approved])
}

// UC-15 – Token đánh giá dùng một lần cho Guest (BR-62), gửi trong email mời đánh giá.
model ReviewToken {
  id        Int       @id @default(autoincrement())
  bookingId Int       @unique
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Lịch tồn phòng homestay theo đêm (BR-07/74).
model HomestayAvailability {
  id            Int      @id @default(autoincrement())
  productId     Int
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  date          DateTime @db.Date
  totalRooms    Int // BR-74: 0 = chặn ngày (không mở bán)
  bookedRooms   Int      @default(0)
  priceOverride Int? // BR-74: giá riêng cho ngày này (mùa/cuối tuần); null = dùng Product.price

  @@unique([productId, date])
  @@index([productId])
}

// ===== Chính sách hủy dạng bảng (UC-14/UC-23, BR-55/114) — dùng chung Homestay & Tour =====
// Thể hiện nhãn kiểu "Easy Refund / Non-refundable"; các mốc do PolicyMilestone định nghĩa.
model CancellationPolicy {
  id           Int               @id @default(autoincrement())
  name         String
  isRefundable Boolean           @default(true)
  freeHours    Int               @default(24) // miễn phí hủy trong X giờ đầu sau khi đặt
  milestones   PolicyMilestone[]
  products     Product[]
  tours        Tour[]
  properties   Property[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

// Mốc hoàn tiền: hủy trước >= daysBefore ngày -> hoàn refundRate%. Lấy mốc lớn nhất thỏa mãn.
model PolicyMilestone {
  id         Int                @id @default(autoincrement())
  policyId   Int
  policy     CancellationPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  daysBefore Int // số ngày trước khởi hành/nhận phòng
  refundRate Int // % hoàn (0-100)

  @@index([policyId])
}

// ===== TOUR — bảng chính (thông tin mô tả), tách hoàn toàn khỏi Product =====
model Tour {
  id                   Int         @id @default(autoincrement())
  tourCode             String      @unique // mã tour nội bộ
  title                String
  slug                 String      @unique // BF-37: đường dẫn SEO
  shortDescription     String? // tagline/mô tả ngắn
  description          String?     @db.Text
  highlights           String?     @db.Text // [Mở rộng] điểm nổi bật (mỗi dòng một mục)
  regionId             Int? // FK Category (kind=region)
  region               Category?   @relation("TourRegion", fields: [regionId], references: [id])
  themeId              Int? // FK Category (kind=theme)
  theme                Category?   @relation("TourTheme", fields: [themeId], references: [id])
  durationDays         Int         @default(1)
  durationNights       Int         @default(0)
  departurePoint       String? // điểm khởi hành/đón
  destination          String? // điểm đến chính
  meetingPoint         String?     @db.Text // [Mở rộng] điểm tập trung + hướng dẫn
  minPax               Int         @default(1)
  maxPax               Int         @default(30)
  guideLanguage        String? // [Mở rộng] ngôn ngữ hướng dẫn
  basePrice            Int // giá tham khảo (từ mức thấp nhất)
  depositRate          Int? // % cọc riêng; null = lấy từ cấu hình UC-23 (BR-113)
  cancellationPolicyId Int?
  cancellationPolicy   CancellationPolicy? @relation(fields: [cancellationPolicyId], references: [id])
  avgRating            Float       @default(0)
  reviewCount          Int         @default(0)
  status               TourStatus  @default(DRAFT) // BR-79: mặc định nháp/ẩn
  thumbnail            String?
  isFeatured           Boolean     @default(false)
  metaTitle            String? // BF-36 SEO
  metaDescription      String? // BF-36 SEO
  createdById          Int? // FK Admin (người tạo)
  createdBy            Admin?      @relation(fields: [createdById], references: [id])
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  images      TourImage[]
  departures  TourDeparture[]
  itinerary   TourItinerary[]
  inclusions  TourInclusion[]
  notes       TourNote[]
  reviews     Review[]
  favorites   Favorite[]
  bookings    Booking[]
  discountCodes DiscountCode[]
  guides      TravelGuideTour[] // cẩm nang du lịch liên quan

  @@index([status])
  @@index([regionId])
  @@index([themeId])
  @@index([isFeatured])
}

// Thư viện ảnh của tour.
model TourImage {
  id        Int     @id @default(autoincrement())
  tourId    Int
  tour      Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  isCover   Boolean @default(false)
  sortOrder Int     @default(0)

  @@index([tourId])
}

// Chuyến khởi hành (đặc trưng cốt lõi của tour). BR-80/81.
model TourDeparture {
  id            Int             @id @default(autoincrement())
  tourId        Int
  tour          Tour            @relation(fields: [tourId], references: [id], onDelete: Cascade)
  departureDate DateTime        @db.Date // BR-80
  returnDate    DateTime?       @db.Date // suy ra từ thời lượng
  totalSlots    Int // BR-81
  bookedSlots   Int             @default(0)
  heldSlots     Int             @default(0) // UC-10: giữ chỗ tạm
  status        DepartureStatus @default(OPEN)
  guideName     String? // [Mở rộng] hướng dẫn viên phụ trách
  prices        TourPrice[]

  @@index([tourId])
}

// Giá theo loại khách, gắn với chuyến khởi hành (BR-33). availableSlots = total-booked-held (tính ở tầng ứng dụng).
model TourPrice {
  id            Int           @id @default(autoincrement())
  departureId   Int
  departure     TourDeparture @relation(fields: [departureId], references: [id], onDelete: Cascade)
  paxType       PaxType
  price         Int
  description   String? // vd "Trẻ em 5–11 tuổi"
  requiresProof Boolean       @default(false) // [Mở rộng] vé ưu đãi cần chứng minh

  @@unique([departureId, paxType])
  @@index([departureId])
}

// Lịch trình theo ngày.
model TourItinerary {
  id            Int     @id @default(autoincrement())
  tourId        Int
  tour          Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade)
  dayNumber     Int
  title         String?
  description   String? @db.Text
  meals         String? // bữa ăn bao gồm (sáng/trưa/tối)
  accommodation String? // nơi nghỉ đêm đó

  @@index([tourId])
}

// Bao gồm / không bao gồm.
model TourInclusion {
  id        Int           @id @default(autoincrement())
  tourId    Int
  tour      Tour          @relation(fields: [tourId], references: [id], onDelete: Cascade)
  type      InclusionType
  itemText  String
  sortOrder Int           @default(0)

  @@index([tourId])
}

// [Mở rộng] "Cần biết trước khi đặt": điều khoản, hướng dẫn dùng vé, FAQ.
model TourNote {
  id      Int          @id @default(autoincrement())
  tourId  Int
  tour    Tour         @relation(fields: [tourId], references: [id], onDelete: Cascade)
  type    TourNoteType
  title   String?
  content String       @db.Text
  sortOrder Int        @default(0)

  @@index([tourId])
}

// ===== PROPERTY — chỗ nghỉ (bảng chính, tách khỏi Product) =====
model Property {
  id                   Int            @id @default(autoincrement())
  propertyCode         String         @unique
  name                 String
  slug                 String         @unique // BF-37
  propertyType         PropertyType   @default(HOMESTAY)
  starRating           Int? // [Mở rộng] hạng sao
  shortDescription     String?
  description          String?        @db.Text
  provinceId           Int? // FK Category (kind=province)
  province             Category?      @relation("PropertyProvince", fields: [provinceId], references: [id])
  areaId               Int? // FK Category (kind=area)
  area                 Category?      @relation("PropertyArea", fields: [areaId], references: [id])
  address              String?
  latitude             Float? // [Mở rộng] SF-02
  longitude            Float? // [Mở rộng]
  checkInTime          String? // giờ nhận phòng "14:00"
  checkOutTime         String? // giờ trả phòng "12:00"
  basePrice            Int // giá tham khảo (mức thấp nhất)
  depositRate          Int? // % cọc riêng; null = cấu hình UC-23 (BR-113)
  cancellationPolicyId Int?
  cancellationPolicy   CancellationPolicy? @relation(fields: [cancellationPolicyId], references: [id])
  avgRating            Float          @default(0)
  reviewCount          Int            @default(0)
  contactPhone         String? // [Mở rộng]
  contactEmail         String? // [Mở rộng]
  status               PropertyStatus @default(DRAFT) // BR-73
  thumbnail            String?
  isFeatured           Boolean        @default(false)
  metaTitle            String? // BF-36
  metaDescription      String? // BF-36
  createdById          Int?
  createdBy            Admin?         @relation(fields: [createdById], references: [id])
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  roomTypes RoomType[]
  images    PropertyImage[]
  amenities PropertyAmenity[]
  policies  PropertyPolicy[]
  reviews   Review[]
  favorites Favorite[]
  bookings  Booking[]
  discountCodes DiscountCode[]

  @@index([status])
  @@index([provinceId])
  @@index([areaId])
  @@index([isFeatured])
}

// Loại phòng (một chỗ nghỉ có nhiều loại phòng).
model RoomType {
  id                Int      @id @default(autoincrement())
  propertyId        Int
  property          Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name              String // Standard, Deluxe, Suite...
  roomSize          Int? // [Mở rộng] diện tích m²
  bedType           String? // cấu hình giường
  maxOccupancy      Int      @default(2)
  totalRooms        Int      @default(1) // số phòng cùng loại (nền tồn kho)
  breakfastIncluded Boolean  @default(false)
  smokingAllowed    Boolean  @default(false) // [Mở rộng]
  basePricePerNight Int
  description       String?  @db.Text // [Mở rộng]

  inventory RoomInventory[]
  images    RoomImage[]
  bookings  Booking[]

  @@index([propertyId])
}

// Lịch tồn phòng theo ngày cho từng loại phòng (BR-74/24 chống trùng).
model RoomInventory {
  id            Int      @id @default(autoincrement())
  roomTypeId    Int
  roomType      RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  date          DateTime @db.Date
  totalRooms    Int // số phòng mở bán ngày đó
  bookedRooms   Int      @default(0)
  heldRooms     Int      @default(0) // UC-09 giữ chỗ tạm
  priceOverride Int? // BR-26 giá riêng ngày đó
  isBlocked     Boolean  @default(false) // UC-16 chặn ngày (bảo trì)

  @@unique([roomTypeId, date])
  @@index([roomTypeId])
}

// Tiện nghi (nhiều-nhiều với Property).
model Amenity {
  id         Int               @id @default(autoincrement())
  name       String            @unique
  icon       String?
  scope      AmenityScope      @default(GENERAL)
  properties PropertyAmenity[]
}

model PropertyAmenity {
  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenityId  Int
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
  @@index([amenityId])
}

model PropertyImage {
  id         Int      @id @default(autoincrement())
  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  caption    String?
  isCover    Boolean  @default(false)
  sortOrder  Int      @default(0)

  @@index([propertyId])
}

model RoomImage {
  id         Int      @id @default(autoincrement())
  roomTypeId Int
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  url        String
  caption    String?
  isCover    Boolean  @default(false)
  sortOrder  Int      @default(0)

  @@index([roomTypeId])
}

// Nội quy & chính sách của chỗ nghỉ (house_rules/note/faq).
model PropertyPolicy {
  id         Int                @id @default(autoincrement())
  propertyId Int
  property   Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  type       PropertyPolicyType @default(HOUSE_RULE)
  title      String?
  content    String             @db.Text
  sortOrder  Int                @default(0)

  @@index([propertyId])
}

// Khu vực du lịch phổ biến hiển thị ở trang chủ.
model Area {
  id    Int     @id @default(autoincrement())
  name  String
  slug  String  @unique
  image String?
  order Int     @default(0)
}

// UC-04 – Trang thông tin & chính sách công khai, và bài viết cẩm nang.
enum InfoCategory {
  ABOUT // thông tin người bán / giới thiệu
  POLICY // các chính sách (BR-10)
  GUIDE // cẩm nang du lịch
}

model InfoArticle {
  id        Int          @id @default(autoincrement())
  slug      String       @unique
  title     String
  category  InfoCategory
  excerpt   String?
  content   String       @db.Text
  published Boolean      @default(true) // BR-11: admin công bố/ẩn
  order     Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([category])
  @@index([published])
}

// Chương trình khuyến mại đang chạy ở trang chủ.
model Promotion {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  image       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([active])
}

// UC-15 – Ảnh đính kèm theo đánh giá (mỗi đánh giá có thể nhiều ảnh).
model ReviewImage {
  id        Int      @id @default(autoincrement())
  reviewId  Int
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([reviewId])
}

// Cẩm nang du lịch (blog): tác giả, ảnh bìa, ngày đăng, địa điểm (bản đồ), tour liên quan.
enum GuideStatus {
  DRAFT
  VISIBLE
  HIDDEN
}

model TravelGuide {
  id           Int         @id @default(autoincrement())
  title        String
  slug         String      @unique
  authorName   String? // tên tác giả
  coverImage   String? // ảnh bìa
  excerpt      String?     @db.Text // tóm tắt ngắn
  content      String      @db.Text // nội dung (nhiều đoạn)
  locationName String? // tên địa điểm
  latitude     Float? // vĩ độ (bản đồ)
  longitude    Float? // kinh độ (bản đồ)
  publishedAt  DateTime? // ngày đăng
  status       GuideStatus @default(DRAFT)
  createdById  Int?
  createdBy    Admin?      @relation(fields: [createdById], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  relatedTours TravelGuideTour[]

  @@index([status])
  @@index([publishedAt])
}

model TravelGuideTour {
  guideId Int
  guide   TravelGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)
  tourId  Int
  tour    Tour        @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@id([guideId, tourId])
  @@index([tourId])
}
